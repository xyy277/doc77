{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/main.ts",
    "src/server.ts",
    "src/tray.ts",
    "src/updater.ts",
    "src/pending-files.ts",
    "src/notifications.ts",
    "src/i18n.ts"
  ]
}
