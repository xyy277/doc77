{
  "name": "@doc77/core",
  "version": "1.2.0",
  "description": "Doc77 Core — database, filesystem abstraction layer, preview engine, Express server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyy277/doc77.git"
  },
  "keywords": [
    "doc77",
    "document",
    "manager",
    "mcp",
    "preview"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup && node -e \"require('fs').cpSync('src/web','dist/web',{recursive:true})\" && npx @tailwindcss/cli -i src/web/css/tailwind.css -o dist/web/css/tailwind.css --minify && node -e \"const fs=require('fs');const p=require('path');['index.html','preview.html'].forEach(f=>{const fp=p.join('dist/web',f);if(!fs.existsSync(fp)){console.error('ERROR: '+fp+' missing after build');process.exit(1)}});console.log('Build OK: web assets verified')\"",
    "dev": "tsup --watch",
    "dev:start": "pnpm -w run dev:start",
    "dev:restart": "pnpm -w run dev:restart",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "chokidar": "^4.0.3",
    "compression": "^1.8.2",
    "express": "^5.1.0",
    "marked": "^17.0.0",
    "multicast-dns": "^7.2.5",
    "pino": "^9.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@codemirror/lang-cpp": "6.0.2",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.9",
    "@codemirror/lang-java": "6.0.1",
    "@codemirror/lang-javascript": "6.2.3",
    "@codemirror/lang-json": "6.0.1",
    "@codemirror/lang-markdown": "6.3.2",
    "@codemirror/lang-php": "6.0.1",
    "@codemirror/lang-python": "6.1.7",
    "@codemirror/lang-rust": "6.0.1",
    "@codemirror/lang-sql": "6.8.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.4.2",
    "@codemirror/search": "6.5.10",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.2",
    "@codemirror/view": "6.43.14",
    "@huggingface/transformers": "^4.2.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/qrcode": "^1.5.6",
    "codemirror": "6.0.1",
    "esbuild": "0.28.1",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "@doc77/ai": "workspace:^",
    "@doc77/mcp": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@doc77/mcp": {
      "optional": true
    },
    "@doc77/ai": {
      "optional": true
    }
  }
}
