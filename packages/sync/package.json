{
  "name": "@doc77/sync",
  "version": "1.1.10",
  "description": "Doc77 Sync Engine — multi-protocol file synchronization (Git, WebDAV, S3)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@doc77/core": "workspace:^",
    "simple-git": "^3.27.0",
    "webdav": "^5.7.0",
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
